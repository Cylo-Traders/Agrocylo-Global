# Server configuration
NODE_ENV=development
PORT=3000

# Stellar / Soroban
RPC_URL=https://soroban-testnet.stellar.org
PRODUCTION_CONTRACT_ID=
ESCROW_CONTRACT_ID=
BASKET_CONTRACT_ID=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth (required in production, >= 32 chars, must not be the dev default)
JWT_SECRET=dev-secret-change-me

# Metrics (required non-empty in production)
METRICS_API_KEY=

# Observability
SENTRY_DSN=

# CORS (comma-separated origins)
CORS_ORIGINS=

# Cache
REDIS_URL=
