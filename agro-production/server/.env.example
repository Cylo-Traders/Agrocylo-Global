# Server configuration
NODE_ENV=development
PORT=3000

# PostgreSQL — required in all environments (separate DB from root server)
DATABASE_URL="postgresql://user:password@localhost:5432/agrocylo_production"

# Stellar / Soroban
# TESTNET DEFAULTS (provisional — maintainer review required before mainnet):
# copied from deployments/deployed-addresses.testnet.json.
RPC_URL=https://soroban-testnet.stellar.org
PRODUCTION_CONTRACT_ID=CD32EWZUKYGU5LU5AAHM4YEZJVIQ3TBO2YHXGBKPOJVAOJYUWDNVUWU6
PRODUCTION_ESCROW_CONTRACT_ID=CD32EWZUKYGU5LU5AAHM4YEZJVIQ3TBO2YHXGBKPOJVAOJYUWDNVUWU6
ESCROW_CONTRACT_ID=CBJXHC2CDO7CYJWUWG4S3VCP5S5YBKHNQBHUFLGDEPH72QD5UCXSWJOW
REGISTRY_CONTRACT_ID=CAUCYVBEPUBFCB3LKLXIT6MWUSLRNGYVRRT37QUKAGSN6CCS2GIR5EQG
BASKET_CONTRACT_ID=CDAWHGW4IP24A4ZPJA3BJPJPVW6P74SAGBNG2JPZ6F3LJ5S5CFFQKXRK

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth (required in production, >= 32 chars, must not be the dev default)
JWT_SECRET=dev-secret-change-me

# Metrics (required non-empty in production)
METRICS_API_KEY=

# Observability
SENTRY_DSN=

# CORS (comma-separated origins)
CORS_ORIGINS=

# Cache
REDIS_URL=

# On-chain event watcher tuning
EVENT_POLL_INTERVAL_MS=5000
CONFIRMATION_DEPTH=10

# Weather advisories (Issue #1341). JSON feed returning an array of
# advisories (or {"advisories": [...]}) in the API's advisory shape. Leave the
# URL empty and GET /api/v1/weather/advisories reports status "unavailable".
WEATHER_ADVISORY_PROVIDER_URL=
WEATHER_ADVISORY_PROVIDER_API_KEY=
WEATHER_ADVISORY_CACHE_TTL_MS=600000
WEATHER_ADVISORY_MAX_STALE_MS=3600000
WEATHER_ADVISORY_RADIUS_KM=100
WEATHER_ADVISORY_TIMEOUT_MS=5000

# Testing — opt-in strictness for leaked handles (CI sets this to 1)
VITEST_FAIL_ON_LEAKS=
