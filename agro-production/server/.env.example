# Server configuration
NODE_ENV=development
PORT=3000

# PostgreSQL — required in all environments (separate DB from root server)
DATABASE_URL="postgresql://user:password@localhost:5432/agrocylo_production"

# Stellar / Soroban
RPC_URL=https://soroban-testnet.stellar.org
PRODUCTION_CONTRACT_ID=
ESCROW_CONTRACT_ID=
BASKET_CONTRACT_ID=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth (required in production, >= 32 chars, must not be the dev default)
JWT_SECRET=dev-secret-change-me

# Metrics (required non-empty in production)
METRICS_API_KEY=

# Observability
SENTRY_DSN=

# CORS (comma-separated origins)
CORS_ORIGINS=

# Cache
REDIS_URL=

# On-chain event watcher tuning
EVENT_POLL_INTERVAL_MS=5000
CONFIRMATION_DEPTH=10

# Testing — opt-in strictness for leaked handles (CI sets this to 1)
VITEST_FAIL_ON_LEAKS=
