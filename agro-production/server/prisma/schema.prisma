// Production Escrow schema
// Tables: users, campaigns, investments, orders, transactions

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  walletAddress String   @unique
  role          UserRole @default(INVESTOR)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  campaigns   Campaign[]    @relation("FarmerCampaigns")
  investments Investment[]
  orders      Order[]

  @@index([walletAddress])
  @@map("users")
}

model Campaign {
  id             String         @id @default(uuid())
  onChainId      String         @unique // uint64 from contract as string
  farmerAddress  String
  tokenAddress   String
  targetAmount   String         // i128 stored as string
  totalRaised    String         @default("0")
  totalRevenue   String         @default("0")
  trancheReleased String        @default("0")
  imageUrl       String?
  deadline       DateTime
  status         CampaignStatus @default(FUNDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  farmer        User           @relation("FarmerCampaigns", fields: [farmerAddress], references: [walletAddress], onDelete: Restrict)
  investments   Investment[]
  orders        Order[]
  transactions  Transaction[]
  disputes      Dispute[]
  conversations Conversation[]
  products      Product[]
  // No `conversations` relation here either: `Conversation` only carries an
  // `orderId` (conversations are per-order, buyer/seller messaging), never a
  // `campaignId` — this was the same class of half-finished relation as
  // `products` below, unbacked and with no callers. Reach a campaign's
  // conversations by joining through its `orders`, not a direct relation.
  // No `products` relation here: a harvested campaign becoming sellable
  // marketplace inventory is a real, wanted feature, but Prisma can't
  // relate across the two independent schemas/databases (this used to be
  // `products Product[]` pointing at a model that only exists in
  // server/prisma/schema.prisma — dead, would fail `prisma generate` the
  // moment anything tried to use it). See docs/architecture/backend-unification.md:
  // cross-backend links go through `walletAddress`/an opaque id scalar and
  // an application-level join, never a schema-level relation.

  @@index([farmerAddress])
  @@index([status])
  @@map("campaigns")
}

// Backing model for the `products` table created by the
// add_product_marketplace migration — the model itself was never added to
// this schema, which broke `prisma generate`/`migrate diff` outright (#744).
model Product {
  id             String   @id @default(uuid())
  name           String
  description    String
  imageUrl       String?
  priceTokens    BigInt
  campaignId     String?
  inventoryCount Int
  category       String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([category])
  @@index([isActive])
  @@map("products")
}

model Investment {
  id             String   @id @default(uuid())
  campaignId     String
  investorAddress String
  amount         String   // i128 as string
  ledger         Int
  txHash         String?
  createdAt      DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  investor User     @relation(fields: [investorAddress], references: [walletAddress], onDelete: Restrict)

  @@unique([campaignId, investorAddress, ledger])
  @@index([campaignId])
  @@index([investorAddress])
  @@map("investments")
}

model Order {
  id            String      @id @default(uuid())
  onChainId     String      @unique // uint64 as string
  campaignId    String
  buyerAddress  String
  amount        String      // i128 as string
  status        OrderStatus @default(PENDING)
  ledger        Int
  txHash        String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  campaign     Campaign                 @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  buyer        User                     @relation(fields: [buyerAddress], references: [walletAddress], onDelete: Restrict)
  disputes     Dispute[]
  conversation MarketplaceConversation?

  @@index([campaignId])
  @@index([buyerAddress])
  @@map("orders")
}

model Basket {
  id                String       @id @default(uuid())
  onChainId         String       @unique // u64 basket id from contract, as string
  constituentsCount Int
  totalDeposited    String       @default("0") // i128 as string
  status            BasketStatus @default(OPEN)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  deposits BasketDeposit[]

  @@index([status])
  @@map("baskets")
}

model BasketDeposit {
  id               String   @id @default(uuid())
  basketId         String
  depositorAddress String
  amount           String   @default("0") // i128 as string, current outstanding deposit
  claimed          Boolean  @default(false)
  payoutAmount     String? // i128 as string, set once claim_basket_returns is indexed
  withdrawn        Boolean  @default(false)
  ledger           Int // ledger of the most recently indexed event for this position
  txHash           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  basket Basket @relation(fields: [basketId], references: [id], onDelete: Cascade)

  @@unique([basketId, depositorAddress])
  @@index([basketId])
  @@index([depositorAddress])
  @@map("basket_deposits")
}

model Transaction {
  id            String            @id @default(uuid())
  campaignId    String?
  walletAddress String?
  eventType     String
  status        TransactionStatus @default(submitted)
  payload       Json
  ledger        Int
  eventIndex    Int
  txHash        String?
  processedAt   DateTime          @default(now())

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@unique([ledger, eventIndex])
  @@index([campaignId])
  @@index([eventType])
  @@index([walletAddress])
  @@index([txHash])
  @@map("transactions")
}

model AuthNonce {
  id            String   @id @default(uuid())
  walletAddress String
  nonce         String   @unique
  audience      String   @default("agro-production")
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime @default(now())

  @@index([nonce])
  @@index([walletAddress])
  @@map("auth_nonces")
}

model EventCursor {
  id           String   @id @default(uuid())
  contractId   String
  ledger       Int
  eventIndex   Int
  ledgerHash   String?  // Hash of the ledger at this sequence — used to detect reorgs
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([contractId])
  @@map("event_cursors")
}

enum CampaignStatus {
  FUNDING
  FUNDED
  IN_PRODUCTION
  HARVESTED
  SETTLED
  FAILED
  DISPUTED
}

enum TransactionStatus {
  awaiting_signature
  submitted
  confirmed
  indexed
  failed
}

enum OrderStatus {
  PENDING
  CONFIRMED
}

enum DisputeStatus {
  Open
  EvidenceSubmitted
  Resolved
  Dismissed
}

enum BasketStatus {
  OPEN
  FUNDED
}

model Dispute {
  id                  String           @id @default(uuid())
  campaignId          String
  orderId             String?
  initiatorAddress    String
  respondentAddress   String
  status              DisputeStatus    @default(Open)
  resolutionOutcome   String?
  resolutionNotes     String?
  transactionHash     String           @unique
  ledgerSequence      Int
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  campaign            Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  order               Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  evidence            DisputeEvidence[]
  auditEntries        DisputeAuditEntry[]

  @@index([campaignId])
  @@index([orderId])
  @@index([initiatorAddress])
  @@index([respondentAddress])
  @@index([status])
  @@index([transactionHash])
  @@map("disputes")
}

model DisputeEvidence {
  id              String   @id @default(uuid())
  disputeId       String
  submitterAddress String
  evidenceUrl     String
  evidenceHash    String
  submittedAt     DateTime @default(now())

  dispute         Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId])
  @@index([submitterAddress])
  @@map("dispute_evidence")
}

model DisputeAuditEntry {
  id            String   @id @default(uuid())
  disputeId     String
  action        String   // "opened", "evidence_submitted", "resolved", "dismissed"
  actorAddress  String
  details       Json     @default("{}")
  createdAt     DateTime @default(now())

  dispute       Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId])
  @@index([createdAt])
  @@map("dispute_audit_entries")
}

model Notification {
  id            String   @id @default(uuid())
  walletAddress String
  message       String
  orderId       String?
  campaignId    String?
  type          String
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([walletAddress])
  @@index([walletAddress, createdAt(sort: Desc)])
  @@index([walletAddress, isRead])
  @@index([orderId])
  @@index([campaignId])
  @@map("notifications")
}

model NotificationPreference {
  walletAddress String   @id
  preferences   Json
  updatedAt     DateTime @updatedAt

  @@map("notification_preferences")
}

/// Buyer-seller chat tied to a marketplace order.
model MarketplaceConversation {
  id            String   @id @default(uuid())
  orderId       String   @unique
  buyerAddress  String
  sellerAddress String
  isArchived    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  order        Order                              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  messages     MarketplaceMessage[]
  participants MarketplaceConversationParticipant[]

  @@index([buyerAddress])
  @@index([sellerAddress])
  @@map("marketplace_conversations")
}

model MarketplaceMessage {
  id             String      @id @default(uuid())
  conversationId String
  senderAddress  String
  content        String      @db.VarChar(4000)
  type           MessageType @default(TEXT)
  fileUrl        String?
  createdAt      DateTime    @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?

  conversation MarketplaceConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderAddress])
  @@map("marketplace_messages")
}

model MarketplaceConversationParticipant {
  id                String   @id @default(uuid())
  conversationId    String
  walletAddress     String
  lastReadMessageId String?
  updatedAt         DateTime @updatedAt

  conversation MarketplaceConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, walletAddress])
  @@index([conversationId])
  @@index([walletAddress])
  @@map("marketplace_conversation_participants")
}

/// Farmer-investor chat tied to a campaign.
model Conversation {
  id              String   @id @default(uuid())
  campaignId      String
  farmerAddress   String
  investorAddress String
  isArchived      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  campaign Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  messages Message[]
  blocks   BlockedUser[]

  @@unique([campaignId, investorAddress])
  @@index([farmerAddress])
  @@index([investorAddress])
  @@map("conversations")
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  senderAddress  String
  content        String      @db.VarChar(4000)
  type           MessageType @default(TEXT)
  fileUrl        String?
  createdAt      DateTime    @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?

  conversation Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reports      MessageReport[]

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderAddress])
  @@map("messages")
}

/// One participant blocking another within a specific campaign conversation.
model BlockedUser {
  id              String   @id @default(uuid())
  conversationId  String
  blockerAddress  String
  blockedAddress  String
  createdAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, blockerAddress, blockedAddress])
  @@index([conversationId])
  @@map("blocked_users")
}

model MessageReport {
  id              String   @id @default(uuid())
  messageId       String
  reporterAddress String
  reason          String   @db.VarChar(1000)
  createdAt       DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_reports")
}

enum MessageType {
  TEXT
  FILE
  SYSTEM
}

model ReconciliationAlert {
  id          String    @id @default(uuid())
  entityType  String    @map("entity_type")  // "campaign" | "order" | "dispute" | "basket"
  entityId    String    @map("entity_id")    // onChainId
  contractSet String    @map("contract_set") // "production_escrow" | "escrow" | "investment_basket"
  driftType   String    @map("drift_type")   // "status_mismatch" | "amount_mismatch" | "missing_on_chain" | "missing_in_db"
  dbValue     Json      @map("db_value")
  chainValue  Json      @map("chain_value")
  detectedAt  DateTime  @default(now()) @map("detected_at")
  resolvedAt  DateTime? @map("resolved_at")
  resolvedBy  String?   @map("resolved_by")
  notes       String?

  @@index([entityType, entityId])
  @@index([detectedAt(sort: Desc)])
  @@index([resolvedAt])
  @@index([driftType])
  @@map("reconciliation_alerts")
}

model AdminAuditLog {
  id            String   @id @default(uuid())
  actorAddress  String
  action        String   // e.g., "reconciliation_run", "alert_resolved"
  resourceType  String?  // e.g., "reconciliation_alert", "campaign"
  resourceId    String?
  details       Json     @default("{}")
  createdAt     DateTime @default(now())

  @@index([actorAddress])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@map("admin_audit_logs")
}

enum UserRole {
  INVESTOR
  FARMER
  BUYER
  ADMIN
}
