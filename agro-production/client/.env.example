# Client environment variables for agro-production/client.
# All vars must be prefixed NEXT_PUBLIC_ to be available in the browser.
# Copy to .env and fill in real values.
#
# Authoritative reference for every variable: docs/deployment/environment.md
# Full agro-production var list: agro-production/.env.example
# `scripts/check-env-drift.js` (CI) fails if this file and the code disagree.

# REST API base URL (server PORT)
NEXT_PUBLIC_API_URL=http://localhost:5001/api/v1

# Comma-separated exact origins allowed for product images. HTTPS is required
# except for localhost development URLs; wildcard hosts are never accepted.
NEXT_PUBLIC_PRODUCT_IMAGE_ORIGINS=

# WebSocket URL — auto-derived from window.location if omitted
NEXT_PUBLIC_WS_URL=ws://localhost:5001/ws

# Soroban RPC endpoint (should match server RPC_URL).
# REQUIRED in production (build fails if missing/empty/malformed); optional in
# development — when absent falls back to https://soroban-testnet.stellar.org.
# When set, must be a valid https:// URL (http:// allowed only for localhost,
# e.g., http://localhost:8000). Malformed or unsupported schemes fail fast with
# variable-named guidance and no secret echo. See src/lib/endpointValidator.ts.
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Stellar network passphrase.
# REQUIRED in production (build/runtime fails if missing); optional in development
# — defaults to "Test SDF Network ; September 2015" (testnet) when absent.
# In mainnet mode an unset or testnet passphrase is a hard error (no silent fallback).
NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Horizon endpoint (optional — overrides per-network default). When set, must be
# a valid https:// URL (http:// allowed only for localhost); malformed or
# unsupported schemes fail fast. See src/lib/endpointValidator.ts.
# NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# On-chain production contract address (mirrors PRODUCTION_CONTRACT_ID /
# PRODUCTION_ESCROW_CONTRACT_ID; value from deployed-addresses.<network>.json)
NEXT_PUBLIC_PRODUCTION_CONTRACT_ID=C...

# Main client URL for navigation back to the main Agrocylo app
NEXT_PUBLIC_MAIN_CLIENT_URL=http://localhost:3000

# ── Dynamic transaction-fee estimation ─────────────────────────────────────
# Congestion percentile (p10..p99), max inclusion fee in stroops, and the
# safety multiplier applied to the estimate.
NEXT_PUBLIC_FEE_PERCENTILE=p70
NEXT_PUBLIC_MAX_INCLUSION_FEE=10000000
NEXT_PUBLIC_FEE_HEADROOM=1.15

# ── Observability [OPTIONAL] ───────────────────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN — browser runtime; SENTRY_DSN — server/build runtime.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# First-party telemetry. Only sent when NEXT_PUBLIC_TELEMETRY_ENABLED=true and
# NEXT_PUBLIC_TELEMETRY_URL is set.
NEXT_PUBLIC_TELEMETRY_ENABLED=false
NEXT_PUBLIC_TELEMETRY_URL=
