# Testnet wallet smoke test inputs (`npm run smoke:wallets`).
# Copy to `.env.testnet`, fill in, and never commit it.
# See docs/WALLETS.md. Secrets stay in the environment; the script prints only
# public keys, transaction hashes, and a truncated signed XDR prefix.

# Two funded Stellar testnet accounts from two *different* wallet families
# (for example a browser-extension wallet and a mobile/deep-link wallet).
STELLAR_TESTNET_SECRET_1=
STELLAR_TESTNET_PUBLIC_1=
STELLAR_TESTNET_SECRET_2=
STELLAR_TESTNET_PUBLIC_2=

# A harmless, idempotent, argument-free method on a scratch testnet contract.
SMOKE_CONTRACT_ID=
SMOKE_FUNCTION_NAME=ping
# JSON array of contract arguments, if the method takes any.
SMOKE_FUNCTION_ARGS=[]

# Optional; defaults to the public testnet RPC.
SOROBAN_TESTNET_RPC_URL=https://soroban-testnet.stellar.org/stellar/rpc
