  "private": true,
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=10.9.0 <11"
  },
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
