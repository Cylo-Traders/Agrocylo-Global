generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Nonce {
  id            String   @id @default(uuid())
  walletAddress String   @unique
  nonce         String
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@map("Nonce")
}

model RefreshToken {
  id            String   @id @default(uuid())
  walletAddress String
  token         String   @unique
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([walletAddress])
  @@map("RefreshToken")
}

model Notification {
  id            String   @id @default(uuid())
  walletAddress String
  message       String
  orderId       String?
  type          String
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([walletAddress])
  @@index([walletAddress, createdAt(sort: Desc)])
  @@index([walletAddress, isRead])
  @@index([orderId])
}

model NotificationPreference {
  walletAddress String   @id
  preferences   Json
  updatedAt     DateTime @updatedAt

  @@map("notification_preferences")
}

model User {
  id            String   @id @default(uuid())
  walletAddress String   @unique
  role          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ordersAsBuyer  Order[] @relation("BuyerOrders")
  ordersAsSeller Order[] @relation("SellerOrders")

  @@map("users")
}

model BuyerDemand {
  id              String    @id @default(uuid())
  buyerWallet     String    @map("buyer_wallet")
  cropName        String    @map("crop_name")
  quantityWanted  String?   @map("quantity_wanted")
  unit            String?
  maxPricePerUnit String?   @map("max_price_per_unit")
  currency        String?
  region          String?
  notes           String?
  neededBy        DateTime? @map("needed_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([buyerWallet])
  @@index([buyerWallet, createdAt(sort: Desc)])
  @@index([cropName])
  @@map("buyer_demands")
}

model FarmerSupply {
  id                String    @id @default(uuid())
  farmerWallet      String    @map("farmer_wallet")
  cropName          String    @map("crop_name")
  quantityAvailable String    @map("quantity_available")
  unit              String?
  pricePerUnit      String?   @map("price_per_unit")
  currency          String?
  availableFrom     DateTime? @map("available_from")
  availableUntil    DateTime? @map("available_until")
  notes             String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([farmerWallet])
  @@index([farmerWallet, availableFrom])
  @@index([cropName, pricePerUnit])
  @@map("farmer_supplies")
}

model Product {
  id            String     @id @default(uuid()) @db.Uuid
  farmerWallet  String     @map("farmer_wallet")
  name          String
  description   String?
  category      String?
  pricePerUnit  Decimal    @map("price_per_unit") @db.Decimal(18, 6)
  currency      String
  unit          String
  stockQuantity Decimal?   @map("stock_quantity") @db.Decimal(10, 2)
  imageUrl      String?    @map("image_url")
  location      String?
  isAvailable   Boolean    @default(true) @map("is_available")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  farmer       Profile             @relation(fields: [farmerWallet], references: [wallet_address], onDelete: Cascade)
  cartItems    CartItem[]
  orders       Order[]
  priceHistory PriceHistory[]
  groupOrders  GroupOrder[]
  priceTiers   ProductPriceTier[]

  @@index([farmerWallet, isAvailable])
  @@map("products")
}

model ProductPriceTier {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  minQuantity  Decimal  @map("min_quantity") @db.Decimal(10, 2)
  pricePerUnit Decimal  @map("price_per_unit") @db.Decimal(18, 6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, minQuantity])
  @@index([productId])
  @@map("product_price_tiers")
}

model Cart {
  id          String     @id @default(uuid()) @db.Uuid
  buyerWallet String     @map("buyer_wallet")
  status      String     @default("active")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  buyer Profile    @relation(fields: [buyerWallet], references: [wallet_address], onDelete: Cascade)
  items CartItem[]

  @@index([buyerWallet])
  @@map("carts")
}

model CartItem {
  id           String   @id @default(uuid()) @db.Uuid
  cartId       String   @map("cart_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  farmerWallet String   @map("farmer_wallet")
  quantity     Decimal  @db.Decimal(10, 2)
  unitPrice    Decimal  @map("unit_price") @db.Decimal(18, 6)
  currency     String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([cartId, farmerWallet])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

model Order {
  id             String   @id @default(uuid())
  orderIdOnChain String   @unique
  buyerAddress   String
  sellerAddress  String
  amount         String
  token          String
  status         String
  productId      String?
  txHash         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  buyerUser  User     @relation("BuyerOrders", fields: [buyerAddress], references: [walletAddress], onDelete: Cascade)
  sellerUser User     @relation("SellerOrders", fields: [sellerAddress], references: [walletAddress], onDelete: Cascade)
  product    Product? @relation(fields: [productId], references: [id])
  dispute    Dispute?

  @@index([sellerAddress])
  @@index([buyerAddress])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([sellerAddress, status])
  @@map("orders")
}

model Campaign {
  id                String   @id @default(uuid())
  campaignIdOnChain String   @unique
  creatorAddress    String
  goalAmount        String
  token             String
  status            String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([creatorAddress])
  @@map("campaigns")
}

model Investment {
  id                String   @id @default(uuid())
  sourceEventId     String   @unique
  campaignIdOnChain String
  investorAddress   String
  amount            String
  token             String
  txHash            String?
  createdAt         DateTime @default(now())

  @@index([campaignIdOnChain])
  @@index([investorAddress])
  @@map("investments")
}

model BlockchainTransaction {
  id                String   @id @default(uuid())
  sourceEventId     String   @unique
  eventType         String
  entity            String
  action            String
  ledger            Int
  eventIndex        Int
  txHash            String?
  orderIdOnChain    String?
  campaignIdOnChain String?
  payload           Json?
  createdAt         DateTime @default(now())

  @@unique([ledger, eventIndex])
  @@index([orderIdOnChain])
  @@index([campaignIdOnChain])
  @@map("transactions")
}

model EscrowEvent {
  id         String   @id @default(uuid())
  orderId    String
  buyer      String
  seller     String
  amount     String
  token      String
  action     String
  ledger     Int
  eventIndex Int
  timestamp  DateTime

  @@unique([ledger, eventIndex])
  @@map("escrow_events")
}

model EscrowTransaction {
  id             String   @id @default(uuid())
  orderIdOnChain String
  action         String
  ledger         Int
  timestamp      DateTime

  @@map("escrow_transactions")
}

model PriceHistory {
  id        String   @id @default(uuid())
  productId String
  price     String
  currency  String
  timestamp DateTime

  product Product @relation(fields: [productId], references: [id])

  @@map("price_history")
}

model Profile {
  wallet_address String    @id
  name           String?   @map("display_name")
  bio            String?
  avatar_url     String?
  role           String    @default("BUYER")
  location       Location?
  products       Product[]
  carts          Cart[]
  reviews        Review[]

  @@map("profiles")
}

model Location {
  wallet_address String   @id
  lat            Float    @map("latitude")
  lng            Float    @map("longitude")
  city           String?
  country        String?
  is_public      Boolean  @default(true)
  profile        Profile? @relation(fields: [wallet_address], references: [wallet_address])

  @@map("locations")
}

model PriceIndex {
  id            String   @id @default(uuid())
  crop          String
  region        String
  currency      String
  avgPrice      Float    @map("avg_price")
  minPrice      Float    @map("min_price")
  maxPrice      Float    @map("max_price")
  sampleCount   Int      @map("sample_count")
  sourceCounts  Json     @map("source_counts")
  computedAt    DateTime @map("computed_at")

  @@unique([crop, region, currency])
  @@index([crop, region])
  @@map("price_index")
}

model WeatherReading {
  id              String    @id @default(uuid())
  walletAddress   String    @map("wallet_address")
  lat             Float
  lng             Float
  temperatureC    Float     @map("temperature_c")
  precipitationMm Float     @map("precipitation_mm")
  windSpeedKph    Float     @map("wind_speed_kph")
  conditionCode   Int       @map("condition_code")
  source          String
  rawPayload      Json      @map("raw_payload")
  recordedAt      DateTime  @map("recorded_at")
  attestedAt      DateTime? @map("attested_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([walletAddress, recordedAt(sort: Desc)])
  @@map("weather_readings")
}

model OrderMetadata {
  on_chain_order_id String @id
  description       String
  farmer_address    String
  buyer_address     String

  @@map("order_metadata")
}

model ReferralCode {
  walletAddress String   @id @map("wallet_address")
  code          String   @unique
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("referral_codes")
}

model Referral {
  id                String    @id @default(uuid())
  referrerWallet    String    @map("referrer_wallet")
  refereeWallet     String    @unique @map("referee_wallet")
  code              String
  /// PENDING until the referee's first confirmed order/investment fires the
  /// reward; REWARDED once the fee-credit has been issued; INELIGIBLE for
  /// self-referral or other disqualified linkages.
  status            String    @default("PENDING")
  rewardedAt        DateTime? @map("rewarded_at")
  /// Fee-credit amount granted to the referrer (platform-fee credit, not a
  /// token mint), denominated in the same unit as order/investment amounts.
  rewardAmount      String?   @map("reward_amount")
  triggerOrderId    String?   @map("trigger_order_id")
  triggerCampaignId String?   @map("trigger_campaign_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([referrerWallet])
  @@index([status])
  @@map("referrals")
}

model FeeCredit {
  id            String    @id @default(uuid())
  walletAddress String    @map("wallet_address")
  amount        String
  reason        String
  sourceReferralId String? @map("source_referral_id")
  consumedAt    DateTime? @map("consumed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([walletAddress])
  @@index([walletAddress, consumedAt])
  @@map("fee_credits")
}

model CropPlan {
  id                    String    @id @default(uuid())
  farmerWallet          String    @map("farmer_wallet")
  cropName              String    @map("crop_name")
  plantedDate           DateTime  @map("planted_date")
  expectedHarvestStart  DateTime  @map("expected_harvest_start")
  expectedHarvestEnd    DateTime  @map("expected_harvest_end")
  expectedVolume        Float?    @map("expected_volume")
  unit                  String?
  region                String?
  linkedCampaignId      String?   @map("linked_campaign_id")
  reminderDaysBefore    Int       @default(7) @map("reminder_days_before")
  reminderSent          Boolean   @default(false) @map("reminder_sent")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([farmerWallet])
  @@index([expectedHarvestStart])
  @@map("crop_plans")
}

model EquipmentListing {
  id              String    @id @default(uuid())
  ownerWallet     String    @map("owner_wallet")
  title           String
  description     String?
  listingType     String    @map("listing_type")
  pricePerUnit    String    @map("price_per_unit")
  depositAmount   String    @default("0") @map("deposit_amount")
  currency        String
  unit            String
  location        String?
  isAvailable     Boolean   @default(true) @map("is_available")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  rentals EquipmentRental[]

  @@index([ownerWallet])
  @@index([listingType])
  @@map("equipment_listings")
}

model EquipmentRental {
  id              String    @id @default(uuid())
  listingId       String    @map("listing_id")
  renterWallet    String    @map("renter_wallet")
  startDate       DateTime  @map("start_date")
  endDate         DateTime  @map("end_date")
  status          String    @default("ACTIVE")
  depositAmount   String    @map("deposit_amount")
  depositRefunded Boolean   @default(false) @map("deposit_refunded")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  listing EquipmentListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([renterWallet])
  @@map("equipment_rentals")
}

model IntegratorApiKey {
  id             String    @id @default(uuid())
  /// SHA-256 hash of the raw key; the raw value is shown to the admin once
  /// at creation time and never stored.
  keyHash        String    @unique @map("key_hash")
  /// Short, non-secret prefix stored alongside the hash so keys can be
  /// identified/labeled in the admin UI without re-deriving the hash.
  keyPrefix      String    @map("key_prefix")
  organizationName String  @map("organization_name")
  /// Scope: explicit farmer wallets this key may read data for. Empty when
  /// the key is scoped by region instead.
  scopedFarmerWallets String[] @map("scoped_farmer_wallets")
  /// Scope: region string (matches Location.city/country) this key may read
  /// aggregate data for. Null when the key is scoped by farmer wallet list.
  scopedRegion   String?   @map("scoped_region")
  createdByAdmin String    @map("created_by_admin")
  revokedAt      DateTime? @map("revoked_at")
  lastUsedAt     DateTime? @map("last_used_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  usageLogs IntegratorApiKeyUsage[]

  @@index([organizationName])
  @@map("integrator_api_keys")
}

model IntegratorApiKeyUsage {
  id           String   @id @default(uuid())
  apiKeyId     String   @map("api_key_id")
  endpoint     String
  statusCode   Int      @map("status_code")
  ipAddress    String?  @map("ip_address")
  requestedAt  DateTime @default(now()) @map("requested_at")

  apiKey IntegratorApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId])
  @@index([apiKeyId, requestedAt(sort: Desc)])
  @@map("integrator_api_key_usage")
}

model ContractWatcherCheckpoint {
  service    String   @id
  lastLedger Int      @map("last_ledger")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("contract_watcher_checkpoints")
}

model GovernanceProposal {
  id             String   @id @default(uuid())
  proposalId     String   @unique @map("proposal_id")
  proposer       String?
  targetContract String?  @map("target_contract")
  functionName   String?  @map("function_name")
  status         String
  votesFor       String   @default("0") @map("votes_for")
  votesAgainst   String   @default("0") @map("votes_against")
  sourceEventId  String   @unique @map("source_event_id")
  ledger         Int
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  votes          GovernanceVote[]

  @@index([status])
  @@map("governance_proposals")
}

model GovernanceVote {
  id            String   @id @default(uuid())
  proposalId    String   @map("proposal_id")
  voter         String
  support       Boolean
  weight        String
  sourceEventId String   @unique @map("source_event_id")
  ledger        Int
  createdAt     DateTime @default(now()) @map("created_at")
  proposal      GovernanceProposal @relation(fields: [proposalId], references: [proposalId], onDelete: Cascade)

  @@unique([proposalId, voter])
  @@index([proposalId])
  @@map("governance_votes")
}

model Dispute {
  id             String    @id @default(uuid())
  orderIdOnChain String    @unique
  raisedBy       String
  status         String
  outcome        String?
  evidenceHash   String?
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  order Order @relation(fields: [orderIdOnChain], references: [orderIdOnChain])

  @@map("disputes")
}

model Review {
  id                String   @id @default(uuid()) @db.Uuid
  subjectWallet     String   @map("subject_wallet")
  reviewerWallet    String   @map("reviewer_wallet")
  reviewerName      String   @map("reviewer_name")
  reviewerRole      String   @map("reviewer_role")
  rating            Int
  title             String
  body              String
  transactionHash   String   @unique @map("transaction_hash")
  verifiedTransaction Boolean @default(true) @map("verified_transaction")
  helpfulVotes      Int      @default(0) @map("helpful_votes")
  helpfulVoteWallets String[] @default([]) @map("helpful_vote_wallets")
  evidence          String[] @default([])
  responseMessage   String?  @map("response_message")
  responderName     String?  @map("responder_name")
  respondedAt       DateTime? @map("responded_at")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [subjectWallet], references: [wallet_address], onDelete: Cascade)

  @@index([subjectWallet, createdAt(sort: Desc)])
  @@index([reviewerWallet])
  @@map("reviews")
}

model GroupOrder {
  id                String   @id @default(uuid()) @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  farmerWallet      String   @map("farmer_wallet")
  targetQuantity    Decimal  @map("target_quantity") @db.Decimal(10, 2)
  committedQuantity Decimal  @default(0) @map("committed_quantity") @db.Decimal(10, 2)
  currency          String
  status            String   @default("PENDING")
  windowEndsAt      DateTime @map("window_ends_at")
  batchTxHash       String?  @map("batch_tx_hash")
  fulfilledAt       DateTime? @map("fulfilled_at")
  expiredAt         DateTime? @map("expired_at")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product      Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  contributions GroupOrderContribution[]

  @@index([productId, status])
  @@index([farmerWallet, status])
  @@index([windowEndsAt])
  @@map("group_orders")
}

model GroupOrderContribution {
  id            String   @id @default(uuid()) @db.Uuid
  groupOrderId   String   @map("group_order_id") @db.Uuid
  buyerWallet    String   @map("buyer_wallet")
  quantity       Decimal  @db.Decimal(10, 2)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(18, 6)
  currency       String
  status         String   @default("RESERVED")
  orderIdOnChain String?  @map("order_id_on_chain")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  groupOrder GroupOrder @relation(fields: [groupOrderId], references: [id], onDelete: Cascade)

  @@index([groupOrderId, buyerWallet])
  @@index([buyerWallet, status])
  @@map("group_order_contributions")
}

model PhoneLink {
  phoneNumber   String   @id
  walletAddress String   @map("wallet_address")
  verifiedAt    DateTime @default(now()) @map("verified_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([walletAddress])
  @@map("phone_links")
}

model UssdSession {
  id            String   @id @default(uuid())
  sessionId     String   @unique @map("session_id")
  phoneNumber   String   @map("phone_number")
  step          String   @default("main_menu")
  state         Json     @default("{}")
  walletAddress String?  @map("wallet_address")
  expiresAt     DateTime @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([phoneNumber])
  @@index([sessionId, expiresAt])
  @@map("ussd_sessions")
}
