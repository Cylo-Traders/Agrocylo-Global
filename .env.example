# Development defaults for docker compose.
# Copy to .env and override any value locally.
# These values allow `docker compose up` to work out of the box.

# PostgreSQL (root marketplace database)
POSTGRES_USER=agrocylo
POSTGRES_PASSWORD=agrocylo_dev_password
POSTGRES_DB=agrocylo

# PostgreSQL (agro-production database)
POSTGRES_AGRO_USER=agro_prod
POSTGRES_AGRO_PASSWORD=agro_prod_dev_password
POSTGRES_AGRO_DB=agrocylo_production

# Redis
REDIS_PASSWORD=redis_dev_password

# Backend (root marketplace)
DATABASE_URL=postgresql://agrocylo:agrocylo_dev_password@postgres:5432/agrocylo
REDIS_URL=redis://:redis_dev_password@redis:6379
NODE_ENV=development

# Backend (agro-production)
DATABASE_URL_AGRO=postgresql://agro_prod:agro_prod_dev_password@postgres-agro:5432/agrocylo_production
REDIS_URL_AGRO=redis://:redis_dev_password@redis:6379
NODE_ENV_AGRO=development

# Clients
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_API_URL_AGRO=http://localhost/api/v1

# Stellar / Soroban (marketplace client + agro-production client)
# REQUIRED in production (build fails if missing/empty/malformed); optional in
# development — fall back to testnet defaults. When set, must be valid https://
# URLs (http:// allowed only for localhost, e.g., http://localhost:8000).
# Malformed or unsupported schemes (ftp://, ws://) or embedded credentials
# always fail fast with variable-named guidance and no secret echo.
# See client/.env.example, agro-production/client/.env.example and
# docs/deployment/environment.md for authoritative required/optional notes.
# Testnet: https://soroban-testnet.stellar.org / https://horizon-testnet.stellar.org
# Mainnet: https://soroban-rpc.mainnet.stellar.org / https://horizon.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
# Passphrase: "Test SDF Network ; September 2015" (testnet) /
# "Public Global Stellar Network ; September 2015" (mainnet)
NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_STELLAR_ENV=testnet
